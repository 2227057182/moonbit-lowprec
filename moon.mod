name = "2227057182/moonbit-lowprec"

version = "0.14.0"

readme = "README.md"

repository = "https://github.com/2227057182/moonbit-lowprec"

license = "Apache-2.0"

keywords = ["float16", "bfloat16", "fixed-point", "quantization", "numeric"]

preferred_target = "wasm"

description = "Low-precision numeric types for MoonBit: binary16 and bfloat16 with correctly rounded arithmetic, direct conversions between the low-precision formats, fixed-point, affine quantization, GGUF block readers for every K-quant type llama.cpp defines, and the 8-bit float formats."
